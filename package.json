{
  "name": "pyrgosfc",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "vercel-build": "npm run migrate:deploy && next build",
    "start": "next start",
    "lint": "eslint",
    "export": "bash scripts/export-static.sh",
    "seed": "node --env-file=.env.local --require ./scripts/preload-next-env.cjs -r tsx/cjs scripts/seed.ts",
    "reset-admin": "node --env-file=.env.local --require ./scripts/preload-next-env.cjs -r tsx/cjs scripts/reset-admin.ts",
    "generate:types": "payload generate:types",
    "migrate:create": "node --env-file=.env.local --require ./scripts/preload-next-env.cjs -r tsx/cjs scripts/migrate.ts migrate:create",
    "migrate": "node --env-file=.env.local --require ./scripts/preload-next-env.cjs -r tsx/cjs scripts/migrate.ts migrate",
    "migrate:status": "node --env-file=.env.local --require ./scripts/preload-next-env.cjs -r tsx/cjs scripts/migrate.ts migrate:status",
    "migrate:deploy": "node --require ./scripts/preload-next-env.cjs -r tsx/cjs scripts/migrate.ts migrate"
  },
  "dependencies": {
    "@lexical/link": "0.41.0",
    "@lexical/list": "0.41.0",
    "@lexical/react": "0.41.0",
    "@lexical/rich-text": "0.41.0",
    "@lexical/selection": "0.41.0",
    "@lexical/utils": "0.41.0",
    "@payloadcms/db-postgres": "^3.43.0",
    "@payloadcms/next": "^3.43.0",
    "@payloadcms/richtext-lexical": "^3.43.0",
    "@payloadcms/storage-vercel-blob": "^3.85.2",
    "clsx": "^2.1.1",
    "framer-motion": "^12.42.2",
    "graphql": "^16.9.0",
    "lexical": "0.41.0",
    "lucide-react": "^1.23.0",
    "next": "16.2.10",
    "nodemailer": "^9.0.3",
    "payload": "^3.43.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sharp": "^0.33.5",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cross-env": "^7.0.3",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "tailwindcss": "^4",
    "tsx": "^4.19.2",
    "typescript": "^5"
  }
}
